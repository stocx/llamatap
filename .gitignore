llamatap-buffer.txt
llamatap.log
runs/

__pycache__/
*.pyc
*.bak
*.bak-*

# Harness and agent scratch. Pointing a harness or a review agent at this repo
# as its working directory leaves its workings here — generated test programs,
# linter caches — and none of it is source. Keeping these listed means a stray
# file shows up as untracked and gets noticed, instead of blending in.
hello_world_test/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
